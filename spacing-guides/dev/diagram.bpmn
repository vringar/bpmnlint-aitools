<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:startEvent id="StartEvent_1" name="Start">
      <bpmn:outgoing>Flow_StartA</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_A" name="Task A">
      <bpmn:incoming>Flow_StartA</bpmn:incoming>
      <bpmn:outgoing>Flow_AB</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_B" name="Task B">
      <bpmn:incoming>Flow_AB</bpmn:incoming>
      <bpmn:outgoing>Flow_BC</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_C" name="Task C">
      <bpmn:incoming>Flow_BC</bpmn:incoming>
      <bpmn:outgoing>Flow_CEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="End">
      <bpmn:incoming>Flow_CEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartA" sourceRef="StartEvent_1" targetRef="Task_A" />
    <bpmn:sequenceFlow id="Flow_AB" sourceRef="Task_A" targetRef="Task_B" />
    <bpmn:sequenceFlow id="Flow_BC" sourceRef="Task_B" targetRef="Task_C" />
    <bpmn:sequenceFlow id="Flow_CEnd" sourceRef="Task_C" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_1">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1">
        <dc:Bounds x="160" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_A_di" bpmnElement="Task_A">
        <dc:Bounds x="260" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_B_di" bpmnElement="Task_B">
        <dc:Bounds x="460" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_C_di" bpmnElement="Task_C">
        <dc:Bounds x="660" y="178" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="EndEvent_1">
        <dc:Bounds x="860" y="200" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_StartA_di" bpmnElement="Flow_StartA">
        <di:waypoint x="196" y="218" />
        <di:waypoint x="260" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AB_di" bpmnElement="Flow_AB">
        <di:waypoint x="360" y="218" />
        <di:waypoint x="460" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_BC_di" bpmnElement="Flow_BC">
        <di:waypoint x="560" y="218" />
        <di:waypoint x="660" y="218" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CEnd_di" bpmnElement="Flow_CEnd">
        <di:waypoint x="760" y="218" />
        <di:waypoint x="860" y="218" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
